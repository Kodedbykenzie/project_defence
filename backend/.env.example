[TEMPLATE]
# Database
DATABASE_URL=postgres://...
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Auth
JWT_SECRET=...                       # if not using Supabase Auth
GOOGLE_CLIENT_ID=...
RESET_CODE_PEPPER=...

# Chain (local Hardhat node by default; set Sepolia values for pilot)
SEPOLIA_RPC_URL=http://127.0.0.1:8545
# For production Sepolia deployment:
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<key>
ISSUER_PRIVATE_KEY=0x...
CREDENTIAL_CONTRACT_ADDRESS=0x...

# App
APP_ORIGIN=https://imari.app

# Admin account (created by default on `npm run db:seed`)
ADMIN_EMAIL=admin@imari.rw
ADMIN_NAME=Precious Mozia
ADMIN_PASSWORD=demo1234

PORT=4000